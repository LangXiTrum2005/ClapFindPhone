<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="9dp"/>
            <solid android:color="#6403a3"/>
            <stroke
                android:width="1dp"
                android:color="#d171ff"/>
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <clip>
            <shape>
                <corners android:radius="6dp"/>
                <gradient
                    android:startColor="#dd8cff"
                    android:endColor="#874aff"
                    android:angle="270"/>
            </shape>
        </clip>
    </item>
</layer-list>
